---
import Base from './Base.astro';
import PageHeader from '../components/PageHeader.astro';
import { hubs, guides, type HubId } from '../data/calculators';
import TableNotice from '../components/TableNotice.astro';
import { NEC_TABLES } from '../data/nec-tables';

const { frontmatter } = Astro.props;
const hubId = (Object.keys(hubs) as HubId[]).find((id) => hubs[id].href === frontmatter.hubHref);
const crumbs = [{ name: frontmatter.hub, href: frontmatter.hubHref }, { name: frontmatter.crumb, href: Astro.url.pathname }];
const isGuide = guides.some((g) => Astro.url.pathname.includes(`/${g.slug}/`));
const chips = [{ label: frontmatter.hub, href: frontmatter.hubHref }, { label: 'Free, no sign-up' }, { label: isGuide ? 'Worked examples' : 'Formula and worked example' }];
---
<Base title={frontmatter.title} description={frontmatter.description} breadcrumbs={crumbs} activeHub={hubId} noindex={Boolean(frontmatter.needsTables) && !NEC_TABLES.verified}>
  <PageHeader title={frontmatter.h1} lead={frontmatter.description} eyebrow={isGuide ? 'Guide' : 'Calculator'} crumbs={crumbs} chips={chips} />
  <article class="article prose">
    {frontmatter.needsTables && <TableNotice />}
    <slot />
    <aside class="cta">
      <div>
        <p class="cta-title">Want these calculations in a workbook?</p>
        <p class="cta-sub">The Electrical Engineer's Toolkit is an Excel workbook from the author of this site.</p>
      </div>
      <a class="btn" href="/toolkit/">See the toolkit</a>
    </aside>
  </article>
</Base>
