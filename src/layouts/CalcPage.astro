---
import Base from './Base.astro';
import PageHeader from '../components/PageHeader.astro';
import { hubs, guides, type HubId } from '../data/calculators';
import TableNotice from '../components/TableNotice.astro';
import { pendingTables } from '../data/nec-tables';
import { lastUpdated, slugFromPath } from '../lib/updated';
import { reviews } from '../data/reviews';
import { corrections } from '../data/corrections';

const { frontmatter } = Astro.props;
const hubId = (Object.keys(hubs) as HubId[]).find((id) => hubs[id].href === frontmatter.hubHref);
const crumbs = [{ name: frontmatter.hub, href: frontmatter.hubHref }, { name: frontmatter.crumb, href: Astro.url.pathname }];
const isGuide = guides.some((g) => Astro.url.pathname.includes(`/${g.slug}/`));
const slug = slugFromPath(Astro.url.pathname, import.meta.env.BASE_URL);
const updated = lastUpdated(slug);
const reviewed = reviews[slug];
const pageCorrections = corrections.filter((c) => c.page === slug);
const chips = [{ label: frontmatter.hub, href: frontmatter.hubHref }, { label: 'Free, no sign-up' }, { label: isGuide ? 'Worked examples' : 'Formula and worked example' }];
---
<Base title={frontmatter.title} description={frontmatter.description} breadcrumbs={crumbs} activeHub={hubId} noindex={Boolean(frontmatter.needsTables) && pendingTables(`/${slug}/`).length > 0}>
  <PageHeader title={frontmatter.h1} lead={frontmatter.description} eyebrow={isGuide ? 'Guide' : 'Calculator'} crumbs={crumbs} chips={chips} updated={updated} reviewed={reviewed} />
  <article class="article prose">
    {frontmatter.needsTables && <TableNotice path={`/${slug}/`} />}
    {pageCorrections.length > 0 && (
      <div class="notice correction" role="note"><strong>Corrected.</strong> {pageCorrections.map((c) => <span>{c.date}: {c.fixed} </span>)}<a href="/corrections/">Corrections log</a></div>
    )}
    <slot />
    <aside class="cta">
      <div>
        <p class="cta-title">Want these calculations in a workbook?</p>
        <p class="cta-sub">The Electrical Engineer's Toolkit is an Excel workbook from the author of this site.</p>
      </div>
      <a class="btn" href="/toolkit/">See the toolkit</a>
    </aside>
  </article>
</Base>
