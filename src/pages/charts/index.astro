---
import Base from '../../layouts/Base.astro';
import PageHeader from '../../components/PageHeader.astro';
import { charts, hubs } from '../../data/calculators';
const crumbs = [{ name: 'Charts and tables', href: '/charts/' }];
const groups = (['electrical', 'protection'] as const).map((id) => ({ hub: hubs[id], items: charts.filter((c) => c.hub === id) }));
---
<Base title="Electrical Charts and Tables | Ohmetry" description="Reference charts for kW and amps, voltage drop, wire resistance, transformer current, fault level and power factor, each with its formula and a worked example." breadcrumbs={crumbs}>
  <PageHeader title="Charts and tables" lead="Reference charts generated from the same formulas the calculators use, each with the method and a worked example." eyebrow="Reference" crumbs={crumbs} />
  <div class="wrap" style="padding-top:28px">
    {groups.map((g) => (
      <>
        <div class="group-title">{g.hub.name}</div>
        <div class="card-grid">
          {g.items.map((c) => (
            <a class="card calc-card" href={`/${c.slug}/`}><span class="tag">CHART</span><h3>{c.name}</h3><p>{c.blurb}</p></a>
          ))}
        </div>
      </>
    ))}
  </div>
</Base>
