---
import Base from '../../layouts/Base.astro';
import PageHeader from '../../components/PageHeader.astro';
import { hubs, calcsIn } from '../../data/calculators';
const hub = hubs['electrical'];
const crumbs = [{ name: hub.name, href: hub.href }];
---
<Base title="Electrical Calculators | Ohmetry" description="Ohm's law, power, current, voltage drop, breaker size and wire gauge calculators with formulas and worked examples." breadcrumbs={crumbs} activeHub="electrical">
  <PageHeader title={`${hub.name} calculators`} lead={hub.blurb} eyebrow="Toolbox" crumbs={crumbs} />
  <div class="wrap" style="padding-top:28px">
    <div class="card-grid">
      {calcsIn('electrical').map((c) => (
        <a class="card calc-card" href={`/${c.slug}/`}>
          {c.tag && <span class="tag">{c.tag}</span>}
          <h3>{c.name}</h3>
          <p>{c.blurb}</p>
        </a>
      ))}
    </div>
    <div class="group-title">Guides</div><div class="card-grid"><a class="card calc-card" href="/voltage-drop-formula/"><span class="tag">GUIDE</span><h3>Voltage drop formula</h3><p>DC, single-phase and three-phase, worked in mm² and AWG.</p></a></div>
  </div>
</Base>
