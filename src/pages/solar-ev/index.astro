---
import Base from '../../layouts/Base.astro';
import PageHeader from '../../components/PageHeader.astro';
import { hubs, calcsIn } from '../../data/calculators';
const hub = hubs['solar-ev'];
const crumbs = [{ name: hub.name, href: hub.href }];
---
<Base title="Solar and EV Calculators | Ohmetry" description="Solar array, battery, inverter, DC cable and EV charger calculators with stated assumptions and worked examples." breadcrumbs={crumbs} activeHub="solar-ev">
  <PageHeader title={`${hub.name} calculators`} lead={hub.blurb} eyebrow="Toolbox" crumbs={crumbs} />
  <div class="wrap" style="padding-top:28px">
    <div class="card-grid">
      {calcsIn('solar-ev').map((c) => (
        <a class="card calc-card" href={`/${c.slug}/`}>
          {c.tag && <span class="tag">{c.tag}</span>}
          <h3>{c.name}</h3>
          <p>{c.blurb}</p>
        </a>
      ))}
    </div>
    
  </div>
</Base>
