---
import Base from '../../../layouts/Base.astro';
import ProjectCard from '../../../components/ProjectCard.astro';
import { publishedProjects, technologies, branches, difficulties } from '../../../data/makerlab';

const crumbs = [
  { name: 'MakerLab', href: '/makerlab/' },
  { name: 'Projects', href: '/makerlab/projects/' },
];

const techList = technologies.filter(t => publishedProjects.some(p => p.technology === t));
---
<Base
  title="All Engineering Projects — Ohmetry MakerLab"
  description="Browse all downloadable engineering project packages for Arduino, ESP32, Raspberry Pi, IoT and Robotics. Filter by technology, branch or difficulty."
  breadcrumbs={crumbs}
>
  <div class="wrap ml-listing-wrap">
    <div class="block-head" style="margin-bottom:24px;">
      <div>
        <span class="eyebrow">MakerLab</span>
        <h1 style="font:800 clamp(1.8rem,3.5vw,2.4rem)/1.1 var(--font-display);font-stretch:112%;letter-spacing:-0.02em;margin:8px 0 0;">
          All projects
          <span class="count-badge" id="result-count">{publishedProjects.length}</span>
        </h1>
      </div>
      <a class="btn ghost" href="/makerlab/">Back to MakerLab</a>
    </div>

    <!-- Filter bar -->
    <div class="filter-bar">
      <div class="filter-group">
        <span class="filter-label">Technology</span>
        <div class="filter-chips">
          <button class="chip active" data-filter="tech" data-value="">All</button>
          {techList.map(t => (
            <button class="chip" data-filter="tech" data-value={t}>{t}</button>
          ))}
        </div>
      </div>
      <div class="filter-group">
        <span class="filter-label">Branch</span>
        <div class="filter-chips">
          <button class="chip active" data-filter="branch" data-value="">All</button>
          {branches.map(b => (
            <button class="chip" data-filter="branch" data-value={b}>{b}</button>
          ))}
        </div>
      </div>
      <div class="filter-group">
        <span class="filter-label">Difficulty</span>
        <div class="filter-chips">
          <button class="chip active" data-filter="diff" data-value="">All</button>
          {difficulties.map(d => (
            <button class="chip" data-filter="diff" data-value={d}>{d}</button>
          ))}
        </div>
      </div>
    </div>

    <div class="card-grid" id="project-grid" style="margin-top:32px;">
      {publishedProjects.map(p => (
        <div
          class="project-wrapper"
          data-tech={p.technology}
          data-branch={p.branch.join(',')}
          data-diff={p.difficulty}
        >
          <ProjectCard project={p} />
        </div>
      ))}
    </div>

    <p id="no-results" style="display:none;color:var(--muted);padding:40px 0;text-align:center;">
      No projects match the selected filters.
    </p>
  </div>
</Base>

<style>
.ml-listing-wrap { padding-block: 32px 64px; }
.count-badge { display: inline-flex; align-items: center; justify-content: center; font: 400 0.75rem var(--font-mono); background: var(--accent-soft); color: var(--accent); border-radius: 999px; padding: 2px 10px; vertical-align: middle; margin-left: 10px; }
.filter-bar { display: flex; flex-direction: column; gap: 12px; padding: 20px; background: var(--surface); border: 1px solid var(--line); border-radius: 12px; }
.filter-group { display: flex; align-items: flex-start; gap: 10px; }
.filter-label { font: 600 0.72rem var(--font-mono); letter-spacing: 0.08em; color: var(--muted); min-width: 80px; padding-top: 5px; }
.filter-chips { display: flex; flex-wrap: wrap; gap: 6px; }
.filter-chips .chip { font-size: 0.8rem; padding: 4px 12px; border-radius: 999px; background: var(--paper); border: 1px solid var(--line); color: var(--muted); cursor: pointer; transition: background 0.15s, color 0.15s; }
.filter-chips .chip:hover, .filter-chips .chip.active { background: var(--accent); color: #fff; border-color: var(--accent); }
.project-wrapper { display: contents; }
.project-wrapper.hidden { display: none; }
@media (max-width: 600px) { .filter-group { flex-direction: column; gap: 6px; } .filter-label { min-width: auto; } }
</style>

<script>
const state: Record<string, string> = { tech: '', branch: '', diff: '' };

function applyFilters() {
  const wrappers = document.querySelectorAll<HTMLElement>('.project-wrapper');
  let visible = 0;
  wrappers.forEach(w => {
    const tech = w.dataset.tech ?? '';
    const branches = (w.dataset.branch ?? '').split(',');
    const diff = w.dataset.diff ?? '';
    const show =
      (!state.tech || tech === state.tech) &&
      (!state.branch || branches.includes(state.branch)) &&
      (!state.diff || diff === state.diff);
    w.classList.toggle('hidden', !show);
    if (show) visible++;
  });
  const badge = document.getElementById('result-count');
  if (badge) badge.textContent = String(visible);
  const noResults = document.getElementById('no-results') as HTMLElement | null;
  if (noResults) noResults.style.display = visible === 0 ? 'block' : 'none';
}

document.querySelectorAll<HTMLButtonElement>('.filter-chips .chip').forEach(btn => {
  btn.addEventListener('click', () => {
    const filter = btn.dataset.filter!;
    state[filter] = btn.dataset.value!;
    // Update active state within same group
    btn.closest('.filter-chips')!.querySelectorAll('.chip').forEach(c => c.classList.remove('active'));
    btn.classList.add('active');
    applyFilters();
  });
});
</script>
