---
import Base from '../../../layouts/Base.astro';
import ProjectCard from '../../../components/ProjectCard.astro';
import { publishedProjects, technologies, branches, difficulties } from '../../../data/makerlab';

const url = Astro.url;
const techFilter = url.searchParams.get('tech') ?? '';
const branchFilter = url.searchParams.get('branch') ?? '';
const diffFilter = url.searchParams.get('diff') ?? '';

const filtered = publishedProjects.filter(p => {
  if (techFilter && p.technology !== techFilter) return false;
  if (branchFilter && !p.branch.includes(branchFilter as never)) return false;
  if (diffFilter && p.difficulty !== diffFilter) return false;
  return true;
});

const crumbs = [
  { name: 'MakerLab', href: '/makerlab/' },
  { name: 'Projects', href: '/makerlab/projects/' },
];

function filterUrl(params: Record<string, string>) {
  const u = new URLSearchParams();
  if (params.tech) u.set('tech', params.tech);
  if (params.branch) u.set('branch', params.branch);
  if (params.diff) u.set('diff', params.diff);
  const q = u.toString();
  return `/makerlab/projects/${q ? '?' + q : ''}`;
}
---
<Base
  title="All Engineering Projects — Ohmetry MakerLab"
  description="Browse all downloadable engineering project packages for Arduino, ESP32, Raspberry Pi, IoT and Robotics. Filter by technology, branch or difficulty."
  breadcrumbs={crumbs}
>
  <div class="wrap ml-listing-wrap">
    <div class="block-head" style="margin-bottom:24px;">
      <div>
        <span class="eyebrow">MakerLab</span>
        <h1 style="font:800 clamp(1.8rem,3.5vw,2.4rem)/1.1 var(--font-display);font-stretch:112%;letter-spacing:-0.02em;margin:8px 0 0;">
          {techFilter || branchFilter || diffFilter ? 'Filtered projects' : 'All projects'}
          <span class="count-badge">{filtered.length}</span>
        </h1>
      </div>
      <a class="btn ghost" href="/makerlab/">Back to MakerLab</a>
    </div>

    <!-- Filter bar -->
    <div class="filter-bar">
      <!-- Technology -->
      <div class="filter-group">
        <span class="filter-label">Technology</span>
        <div class="filter-chips">
          <a class={`chip ${!techFilter ? 'active' : ''}`} href={filterUrl({ branch: branchFilter, diff: diffFilter })}>All</a>
          {technologies.filter(t => publishedProjects.some(p => p.technology === t)).map(t => (
            <a class={`chip ${techFilter === t ? 'active' : ''}`} href={filterUrl({ tech: t, branch: branchFilter, diff: diffFilter })}>{t}</a>
          ))}
        </div>
      </div>
      <!-- Branch -->
      <div class="filter-group">
        <span class="filter-label">Branch</span>
        <div class="filter-chips">
          <a class={`chip ${!branchFilter ? 'active' : ''}`} href={filterUrl({ tech: techFilter, diff: diffFilter })}>All</a>
          {branches.map(b => (
            <a class={`chip ${branchFilter === b ? 'active' : ''}`} href={filterUrl({ tech: techFilter, branch: b, diff: diffFilter })}>{b}</a>
          ))}
        </div>
      </div>
      <!-- Difficulty -->
      <div class="filter-group">
        <span class="filter-label">Difficulty</span>
        <div class="filter-chips">
          <a class={`chip ${!diffFilter ? 'active' : ''}`} href={filterUrl({ tech: techFilter, branch: branchFilter })}>All</a>
          {difficulties.map(d => (
            <a class={`chip ${diffFilter === d ? 'active' : ''}`} href={filterUrl({ tech: techFilter, branch: branchFilter, diff: d })}>{d}</a>
          ))}
        </div>
      </div>
    </div>

    {filtered.length === 0 ? (
      <div class="card" style="padding:40px;text-align:center;color:var(--muted);">
        <p>No projects match the selected filters. <a href="/makerlab/projects/">Clear filters</a></p>
      </div>
    ) : (
      <div class="card-grid" style="margin-top:32px;">
        {filtered.map(p => <ProjectCard project={p} />)}
      </div>
    )}
  </div>
</Base>

<style>
.ml-listing-wrap { padding-block: 32px 64px; }
.count-badge { display: inline-flex; align-items: center; justify-content: center; font: 400 0.75rem var(--font-mono); background: var(--accent-soft); color: var(--accent); border-radius: 999px; padding: 2px 10px; vertical-align: middle; margin-left: 10px; }
.filter-bar { display: flex; flex-direction: column; gap: 12px; padding: 20px; background: var(--surface); border: 1px solid var(--line); border-radius: 12px; }
.filter-group { display: flex; align-items: flex-start; gap: 10px; }
.filter-label { font: 600 0.72rem var(--font-mono); letter-spacing: 0.08em; color: var(--muted); min-width: 80px; padding-top: 5px; }
.filter-chips { display: flex; flex-wrap: wrap; gap: 6px; }
.filter-chips .chip { text-decoration: none; font-size: 0.8rem; padding: 4px 12px; border-radius: 999px; background: var(--paper); border: 1px solid var(--line); color: var(--muted); transition: background 0.15s, color 0.15s; }
.filter-chips .chip:hover, .filter-chips .chip.active { background: var(--accent); color: #fff; border-color: var(--accent); }
@media (max-width: 600px) { .filter-group { flex-direction: column; gap: 6px; } .filter-label { min-width: auto; } }
</style>
